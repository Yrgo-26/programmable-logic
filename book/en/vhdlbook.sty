% vhdlbook.sty - the design of "Programmable Logic" as a book.
%
% Every visual decision lives here, so the chapters describe content and nothing else. The design is
% the house style for these course books, turned for a course written almost entirely in
% VHDL: VHDL takes the accent, C++ (one section) gets a block of its own, the
% figures are the course's own generated PNGs placed in the page's own measure, and the tool
% references and the shared protocol documents become appendices.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{vhdlbook}[2026/09/12 Programmable Logic book design]

% ------------------------------------------------------------------------------------------
% Page. 7.5 x 9.25 in, a common trim for programming texts; the text block is wide enough for an
% 84-column line of code at the listing size.
% ------------------------------------------------------------------------------------------
\RequirePackage[
  paperwidth=7.5in, paperheight=9.25in,
  inner=0.85in, outer=1.15in, top=0.95in, bottom=1.0in,
  headheight=14pt, headsep=18pt, footskip=30pt]{geometry}

% ------------------------------------------------------------------------------------------
% Type. Palatino for the text, and DejaVu Sans Mono for code: a signal or type name reads the same
% in a sentence as in a listing, and as in a figure.
% ------------------------------------------------------------------------------------------
\RequirePackage{fontspec}
\RequirePackage{unicode-math}
\setmainfont{TeX Gyre Pagella}
\setsansfont{TeX Gyre Heros}[Scale=MatchLowercase]
% A space inside inline code may stretch a little, as a word space does; listings set their own
% fixed columns and are not affected.
\setmonofont{DejaVu Sans Mono}[Scale=0.84, HyphenChar=None, WordSpace={1,0.4,0.15}]
\setmathfont{TeX Gyre Pagella Math}
\RequirePackage[protrusion=true, expansion=true, tracking=true]{microtype}
\SetTracking{encoding=*, shape=sc}{40}

% ------------------------------------------------------------------------------------------
% Language. English throughout, which is what names the headings "Chapter", "Appendix" and
% "Contents", and what gives the text English hyphenation patterns. This is the English edition
% of a book written in Swedish; Swedish is kept as a second language for the few words that stay
% in it, the companion volume's title among them.
% ------------------------------------------------------------------------------------------
\RequirePackage{polyglossia}
\setmainlanguage{english}
\setotherlanguage{swedish}

% ------------------------------------------------------------------------------------------
% Colour.
% ------------------------------------------------------------------------------------------
\RequirePackage[table]{xcolor}
\definecolor{accent}{HTML}{C00000}
\definecolor{accent2}{HTML}{0050B3}
\definecolor{accent3}{HTML}{2E7D32}
\definecolor{accent4}{HTML}{B26A00}
\definecolor{accent5}{HTML}{6A3D9A}
\definecolor{muted}{HTML}{767676}
\definecolor{ink}{HTML}{3A3A3A}
\definecolor{fillaccent}{HTML}{F4D7D7}
\definecolor{fillaccent2}{HTML}{D6E4F5}
\definecolor{fillaccent3}{HTML}{D9EDDA}
\definecolor{fillaccent4}{HTML}{F6E5C8}
\definecolor{fillaccent5}{HTML}{E4DAF0}
\definecolor{fillmuted}{HTML}{E8E8E8}
\definecolor{codebg}{HTML}{F6F5F2}
\definecolor{rule}{HTML}{BBBBBB}

% ------------------------------------------------------------------------------------------
% Structure: chapter openers, section heads, running heads.
% ------------------------------------------------------------------------------------------
\RequirePackage{titlesec}
\RequirePackage{titletoc}

\titleformat{\chapter}[display]
  {\normalfont\raggedright}
  {\color{accent}\large\scshape\lsstyle\MakeLowercase{\chaptertitlename}\enspace\thechapter}
  {1.2ex}
  {\fontsize{26}{30}\selectfont\bfseries}
  [\vspace{1.4ex}{\color{rule}\titlerule[0.6pt]}]
\titleformat{name=\chapter, numberless}[display]
  {\normalfont\raggedright}
  {}
  {0pt}
  {\fontsize{26}{30}\selectfont\bfseries}
  [\vspace{1.4ex}{\color{rule}\titlerule[0.6pt]}]
\titlespacing*{\chapter}{0pt}{0.35in}{0.3in}

\titleformat{\section}
  {\normalfont\Large\bfseries\raggedright}
  {\color{accent}\thesection}{0.7em}{}
\titlespacing*{\section}{0pt}{3.2ex plus 1ex minus .2ex}{1.4ex plus .2ex}

\titleformat{\subsection}
  {\normalfont\large\bfseries\raggedright}
  {\color{accent}\thesubsection}{0.7em}{}
\titlespacing*{\subsection}{0pt}{2.6ex plus 1ex minus .2ex}{1.0ex plus .2ex}

\titleformat{\subsubsection}
  {\normalfont\normalsize\bfseries\itshape\raggedright}
  {}{0em}{}
\titlespacing*{\subsubsection}{0pt}{2ex plus .8ex minus .2ex}{0.6ex plus .2ex}

\titleformat{\paragraph}[runin]
  {\normalfont\normalsize\bfseries}
  {}{0em}{}[.]
\titlespacing*{\paragraph}{0pt}{1.4ex plus .5ex minus .2ex}{0.6em}

\setcounter{secnumdepth}{2}
\setcounter{tocdepth}{1}

% Contents: chapters bold with their number in the accent, sections indented beneath, and every
% page number right-aligned in a box of its own, so a three-digit one never meets the leaders.
\titlecontents{part}[0pt]
  {\addvspace{3.4ex}\bfseries\large}
  {}
  {}
  {}
\titlecontents{chapter}[0pt]
  {\addvspace{1.4ex}\bfseries}
  {\makebox[2em][l]{\color{accent}\thecontentslabel}}
  {}
  {\hfill\makebox[2.2em][r]{\contentspage}}
\titlecontents{section}[2em]
  {\addvspace{0.2ex}}
  {\makebox[2.6em][l]{\thecontentslabel}}
  {}
  {\titlerule*[0.6pc]{.}\makebox[2.2em][r]{\contentspage}}

\RequirePackage{fancyhdr}
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
\renewcommand{\chaptermark}[1]{\markboth{#1}{}}
\renewcommand{\sectionmark}[1]{\markright{\thesection\enspace #1}}
\fancyhead[LE]{\small\thepage\qquad\scshape\lsstyle\MakeLowercase{\leftmark}}
\fancyhead[RO]{\small\scshape\lsstyle\MakeLowercase{\rightmark}\qquad\thepage}
\fancypagestyle{plain}{\fancyhf{}\fancyfoot[C]{\small\thepage}}
\RequirePackage{emptypage}

% ------------------------------------------------------------------------------------------
% Text.
% ------------------------------------------------------------------------------------------
% Pages end where their text ends. The class default stretches every gap on a page to square
% the bottom off, which a page with a long listing pushed to the next one cannot survive.
\raggedbottom
% With a ragged bottom there is no reason to leave one line of a paragraph alone on a page.
\clubpenalty=10000
\widowpenalty=10000
\displaywidowpenalty=10000
% Inline code is set in a monospaced face whose spaces cannot stretch, and a name such as
% rxsr_real_bit_valid cannot be hyphenated; a little emergency stretch lets the paragraph builder
% loosen a line around one rather than push it into the margin.
\setlength{\emergencystretch}{2.5em}
\tolerance=1000
\setlength{\parindent}{1.2em}
\linespread{1.06}
\RequirePackage[shortlabels]{enumitem}
\setlist{itemsep=0.25ex, topsep=0.8ex, parsep=0pt}
\setlist[itemize]{leftmargin=1.4em, label={\color{accent}\textbullet}}
\setlist[itemize,2]{leftmargin=1.2em, label={\color{muted}\textendash}}
\setlist[itemize,3]{leftmargin=1.2em, label={\color{muted}\textperiodcentered}}
\setlist[enumerate]{leftmargin=1.6em, label={\bfseries\arabic*.}}

% Inline code. \detokenize is what lets a name like reset_s2_n or an expression like
% (others => '0') be written as it appears in the source, without escaping; vhdlbook.lua undoes
% the two things \detokenize does to code (a doubled # and a space after \n). A literal % or an
% unbalanced brace is written \%, \{ or \}. \file is for file names, which are long and need to
% break at a slash. Robust, so it survives the trip through the contents and the running heads.
\directlua{dofile(kpse.find_file("vhdlbook.lua"))}
% In maths, \code is wrapped in an \mbox: a name inside a formula is still a name, and
% \upshape is illegal in math mode.
\DeclareRobustCommand{\code}[1]{%
  \relax\ifmmode\expandafter\mbox\fi
  {\upshape\ttfamily\directlua{vhdlbook_code("\luaescapestring{\detokenize{#1}}")}}}
% A running head is set in small capitals by lowercasing it; code in a heading keeps its case,
% because STATE_IDLE and state_idle read as two different names.
\ExplSyntaxOn
\tl_put_right:Nn \l_text_case_exclude_arg_tl { \code }
\ExplSyntaxOff
\RequirePackage{xurl}
\urlstyle{tt}
% xurl lets a URL break anywhere, which a long link needs; a file name breaks only at a slash or
% a dot, so no name is ever split in half.
\DeclareUrlCommand{\file}{\urlstyle{tt}\def\UrlBreaks{\do\/\do\.}\def\UrlBigBreaks{}}

% Section references in the terse form the lectures use: (Appendix A.3) becomes (section 2.2).
\newcommand{\secref}[1]{section~\ref{#1}}
\newcommand{\Secref}[1]{Section~\ref{#1}}
% A chapter by its number: \chapref{c4} is "chapter 4", linked. The lectures say "L04"; the book
% says which chapter that is.
\newcommand{\chapref}[1]{chapter~\ref{#1}}
\newcommand{\Chapref}[1]{Chapter~\ref{#1}}

% A lead-in for the notes the lectures are full of: "Note:", "Tip:", "In short:".
\newcommand{\note}[1][Note]{\textbf{#1:}\ }

% The protocol reference this book leans on for CAN itself, written once so every mention of it
% reads the same. \canbook is the title, which is Swedish and stays that way, since that is the
% title the book is found under; \canref{5} names one of its chapters, which are numbered
% independently of this book's, so the word is spelled out rather than left to \chapref.
\newcommand{\canbook}{\textswedish{\emph{CAN: bussen, framen och kontrollern}}}
\newcommand{\canref}[1]{chapter~#1 of \canbook}
\newcommand{\Canref}[1]{Chapter~#1 of \canbook}

% ------------------------------------------------------------------------------------------
% Tables. Rules only where they separate; never a vertical one.
% ------------------------------------------------------------------------------------------
\RequirePackage{booktabs}
\RequirePackage{tabularx}
\RequirePackage{array}
\RequirePackage{longtable}
\newcolumntype{L}{>{\raggedright\arraybackslash}X}
\newcolumntype{C}{>{\centering\arraybackslash}p}
\setlength{\aboverulesep}{0.5ex}
\setlength{\belowrulesep}{0.5ex}
\newcommand{\thead}[1]{\textbf{#1}}
% A table set in the flow of the text, full measure, one size down.
\newenvironment{booktable}[1]
  {\par\smallskip\noindent\small\tabularx{\linewidth}{#1}\toprule}
  {\bottomrule\endtabularx\par\smallskip}
% The same, at its natural width and centred, for tables of short cells.
\newenvironment{narrowtable}[1]
  {\par\smallskip\begin{center}\small\begin{tabular}{#1}\toprule}
  {\bottomrule\end{tabular}\end{center}\par\smallskip}
% A table that may run over a page break, for the long port lists and register maps.
\newenvironment{longbooktable}[2]
  {\par\smallskip\small\begin{longtable}{#1}\toprule #2 \\ \midrule\endfirsthead
   \toprule #2 \\ \midrule\endhead}
  {\bottomrule\end{longtable}\par\smallskip}

% ------------------------------------------------------------------------------------------
% Figures. The course's own generated drawings, placed where they are written. They are PNGs
% under lectures/, built from the Python sources in diagrams/, so the book and the lecture are
% always the same drawing and a redrawn figure needs no edit here.
% ------------------------------------------------------------------------------------------
\RequirePackage{graphicx}
\RequirePackage[export]{adjustbox}
\RequirePackage{tikz}
\usetikzlibrary{arrows.meta, positioning, calc, fit, backgrounds, decorations.pathreplacing,
  shapes.geometric}
\RequirePackage{float}
\RequirePackage{caption}
\captionsetup{font=small, labelfont={bf,color=accent}, labelsep=quad,
  justification=centering, skip=6pt}
% \lecfig[width]{path}{caption}{label}: a figure from the course material, placed here. The path
% is the one from the repository root, and this edition sits two levels below it.
\newcommand{\lecfig}[4][0.86]{%
  \begin{figure}[H]
    \centering
    \includegraphics[width=#1\linewidth, max width=\linewidth, max height=0.62\textheight]{../../#2}%
    \caption{#3}\label{#4}
  \end{figure}}
% \modulefig[width]{path}: a module's box, reprinted where an exercise asks for the module. The
% box carries its own name, so it needs no caption.
\newcommand{\modulefig}[2][0.62]{%
  \par\addvspace{1.4ex}\needspace{6\baselineskip}%
  \noindent\makebox[\linewidth][c]{%
    \includegraphics[width=#1\linewidth, max width=\linewidth, max height=0.4\textheight]{../../#2}}%
  \par\addvspace{1.4ex}}

% ------------------------------------------------------------------------------------------
% Code. A tinted block with a coloured edge; the edge says which language it is. Red for VHDL,
% amber for C++, blue for the shell and for make, grey for what a tool printed back and for any
% other plain text: bit tables, traces, directory trees.
% ------------------------------------------------------------------------------------------
\RequirePackage{listings}
\RequirePackage[most]{tcolorbox}

% listings knows VHDL's reserved words. Add the names the course uses from ieee.std_logic_1164
% and ieee.numeric_std, the standard types, and the edge and conversion functions, as a second
% class: they are not keywords, but a reader looks for them the way one looks for a keyword.
\lstdefinelanguage{vhdl93}[]{VHDL}{
  morekeywords=[2]{std_logic, std_logic_vector, std_ulogic, unsigned, signed, natural, integer,
    positive, boolean, bit, time, string, rising_edge, falling_edge, to_unsigned, to_integer,
    shift_left, shift_right, std_logic_1164, numeric_std, ieee, severity, note, failure},
}

% listings knows C++98. Add what C++11 to C++17 made keywords.
\lstdefinelanguage{cpp17}[ISO]{C++}{
  morekeywords={alignas, alignof, char16_t, char32_t, constexpr, decltype, noexcept, nullptr,
    static_assert, thread_local, override, final, concept, requires, consteval, constinit},
}

\lstdefinestyle{base}{
  basicstyle=\ttfamily\small,
  columns=fixed,
  keepspaces=true,
  showstringspaces=false,
  upquote=true,
  tabsize=4,
  breaklines=true,
  breakatwhitespace=false,
  % A wrapped line is marked at both ends. Boxed, because LuaTeX will not take colour or maths
  % loose inside the discretionary a line break is made of.
  prebreak={\mbox{\textcolor{muted}{\tiny$\hookleftarrow$}}},
  postbreak={\mbox{\textcolor{muted}{\tiny$\hookrightarrow$}\space}},
  aboveskip=0pt, belowskip=0pt,
  commentstyle=\color{muted},
  stringstyle=\color{accent2},
}
\lstdefinestyle{vhdl}{style=base, language=vhdl93,
  keywordstyle=\color{accent2!85!black}\bfseries,
  keywordstyle=[2]\color{accent!80!black}}
\lstdefinestyle{cpp}{style=base, language=cpp17,
  keywordstyle=\color{accent2!85!black}\bfseries,
  directivestyle=\color{accent}}
\lstdefinestyle{shell}{style=base, language=bash,
  keywordstyle={}, morekeywords={}, deletekeywords={test}}
\lstdefinestyle{make}{style=base, language=make,
  keywordstyle={}, morecomment=[l]{\#}}
\lstdefinestyle{output}{style=base, language={}}

\tcbset{
  codeblock/.style={
    enhanced, listing only, breakable,
    colback=codebg, colframe=codebg, boxrule=0pt, arc=0pt, outer arc=0pt,
    left=8pt, right=6pt, top=4pt, bottom=4pt,
    before skip=1.2ex plus 2pt, after skip=1.4ex plus 2pt,
    borderline west={2pt}{0pt}{#1}},
}
\newtcblisting{vhdlcode}{codeblock=accent!70, listing options={style=vhdl}}
\newtcblisting{cppcode}{codeblock=accent4!80, listing options={style=cpp}}
\newtcblisting{shell}{codeblock=accent2!70, listing options={style=shell}}
\newtcblisting{makecode}{codeblock=accent2!70, listing options={style=make}}
\newtcblisting{console}{codeblock=muted!60, listing options={style=output}}

% A drawing made of text with a character outside ASCII in it, an arrow or a box-drawing rule.
% listings cannot set those, it reorders and drops them, so this is verbatim text in the box a
% console listing uses, which keeps every column where the source puts it.
\RequirePackage{fancyvrb}
\newtcolorbox{textdrawingbox}{codeblock=muted!60}
\newenvironment{textdrawing}
  {\VerbatimEnvironment\begin{textdrawingbox}\begin{Verbatim}[fontsize=\small]}
  {\end{Verbatim}\end{textdrawingbox}}
% The same, one size down, for a wide bit table or trace.
\newenvironment{widedrawing}
  {\VerbatimEnvironment\begin{textdrawingbox}\begin{Verbatim}[fontsize=\footnotesize]}
  {\end{Verbatim}\end{textdrawingbox}}

% A source file typeset straight from the repository, so the book and the code cannot drift
% apart. The argument is the path from the repository root, which is also what is printed.
\newtcbinputlisting{\vhdlfile}[1]{codeblock=accent!70, listing options={style=vhdl},
  listing file={../../#1},
  title={\detokenize{#1}}, detach title,
  before upper={\noindent{\scriptsize\ttfamily\color{muted}\tcbtitletext}\par\vspace{3pt}}}
\newtcbinputlisting{\cppfile}[1]{codeblock=accent4!80, listing options={style=cpp},
  listing file={../../#1},
  title={\detokenize{#1}}, detach title,
  before upper={\noindent{\scriptsize\ttfamily\color{muted}\tcbtitletext}\par\vspace{3pt}}}

% ------------------------------------------------------------------------------------------
% Boxes in the text.
% ------------------------------------------------------------------------------------------
% An aside: something true that the surrounding text is not about.
\newtcolorbox{aside}[1][]{
  enhanced, breakable,
  colback=fillaccent2!45, colframe=fillaccent2!45, boxrule=0pt, arc=0pt,
  left=10pt, right=10pt, top=6pt, bottom=6pt,
  borderline west={2.5pt}{0pt}{accent2},
  before skip=2ex, after skip=2ex,
  fontupper=\small,
  #1}
% A warning: something that goes silently wrong if it is skipped.
\newtcolorbox{warning}[1][]{
  enhanced, breakable,
  colback=fillaccent!45, colframe=fillaccent!45, boxrule=0pt, arc=0pt,
  left=10pt, right=10pt, top=6pt, bottom=6pt,
  borderline west={2.5pt}{0pt}{accent},
  before skip=2ex, after skip=2ex,
  fontupper=\small,
  #1}
% The self-check that closes an exercise: the entity name, the port order, and where the
% provided testbench lives.
\newtcolorbox{selfcheck}[1][]{
  enhanced, breakable,
  colback=fillaccent3!45, colframe=fillaccent3!45, boxrule=0pt, arc=0pt,
  left=10pt, right=10pt, top=6pt, bottom=6pt,
  borderline west={2.5pt}{0pt}{accent3},
  before skip=1.6ex, after skip=2ex,
  fontupper=\small,
  #1}
% The box that opens a chapter, listing what is in it.
\newtcolorbox{chapterbox}[1]{
  enhanced, breakable,
  colback=white, colframe=rule, boxrule=0.5pt, arc=0pt,
  left=10pt, right=10pt, top=8pt, bottom=6pt,
  fonttitle=\small\scshape\lsstyle, coltitle=accent, colbacktitle=white,
  attach boxed title to top left={xshift=8pt, yshift=-2.2mm},
  boxed title style={boxrule=0pt, arc=0pt, left=3pt, right=3pt, top=0pt, bottom=0pt},
  title={#1},
  before skip=2ex, after skip=2.5ex,
  fontupper=\small}

% ------------------------------------------------------------------------------------------
% Every heading from here on ends with \@afterheading, so the paragraph after it starts flush
% left, as it does after a \section.
%
% Exercises. The lectures number their exercises within the lecture; the book numbers them within
% the chapter, so that exercise 3 of L04 is Exercise 4.3 and can never be mistaken for section 4.3
% or for another chapter's. Each carries its kind, which picks the colour of its tag.
% ------------------------------------------------------------------------------------------
\RequirePackage{needspace}
\newcounter{exercise}[chapter]
\renewcommand{\theexercise}{\thechapter.\arabic{exercise}}
\newcounter{exerciseset}[chapter]
\newcommand{\kindtag}[2][fillmuted]{%
  \tcbox[on line, colback=#1, colframe=#1, boxrule=0pt, arc=1.5pt,
    left=3pt, right=3pt, top=1pt, bottom=1pt, boxsep=0pt]{%
    \small\scshape\lsstyle\MakeLowercase{#2}}}
% The five kinds, and the fill each is tagged with. VHDL is a module you write and check against
% its testbench; Circuit is a circuit you build and simulate by hand in CircuitVerse; Simulation
% is what you find out by running GHDL on something you changed; Reasoning is what you answer in
% words or numbers; C++ is the one section written in C++.
\ExplSyntaxOn
\cs_new:Npn \kindfill #1
  {
    \str_case:nnF {#1}
      {
        {VHDL} {fillaccent}
        {C++} {fillaccent4}
        {Reasoning} {fillaccent2}
        {Simulation} {fillaccent3}
        {Circuit} {fillaccent5}
      }
      {fillmuted}
  }
\ExplSyntaxOff
% \exerciseset{Title}: the heading a group of exercises sits under.
\newcommand{\exerciseset}[1]{%
  \par\addvspace{4ex plus 1ex}\needspace{8\baselineskip}%
  \refstepcounter{exerciseset}%
  \noindent{\small\scshape\lsstyle\color{accent}exercise set \theexerciseset}\par
  \nopagebreak\vspace{0.3ex}%
  \noindent{\Large\bfseries #1}\par
  \nopagebreak\vspace{0.4ex}{\color{rule}\hrule height 0.4pt}\par\nopagebreak\vspace{0.6ex}%
  \@afterindentfalse\@afterheading}
% \exercise{Title}{Kind}, or \exercise[fill]{Title}{Kind} to pick the tag's fill by hand.
\newcommand{\exercise}[3][]{%
  \par\addvspace{3ex plus 1ex}\needspace{8\baselineskip}%
  \refstepcounter{exercise}%
  \if\relax\detokenize{#1}\relax\edef\vhb@fill{\kindfill{#3}}\else\def\vhb@fill{#1}\fi
  \noindent{\large\bfseries{\color{accent}Exercise~\theexercise}\quad #2}%
  \hskip 1em plus 1fill\kindtag[\vhb@fill]{#3}%
  \par\nopagebreak\vspace{0.8ex}\@afterindentfalse\@afterheading}
% \xpart{a}: the lead-in of a lettered part of an exercise, a paragraph of its own, as the
% lectures letter them. A part with a title of its own continues \xpart{a}\parttitle{Entiteten.}
\newcommand{\xpart}[1]{\par\addvspace{1.4ex}\noindent\textbf{#1)}\enspace\ignorespaces}
\newcommand{\parttitle}[1]{\textbf{#1}\enspace\ignorespaces}
% A part of an exercise with a heading of its own: "Tasks", "Hints".
\newcommand{\task}[1]{\par\addvspace{1.6ex}\needspace{4\baselineskip}%
  \noindent{\bfseries #1}\par\nopagebreak\vspace{0.3ex}\@afterindentfalse\@afterheading}

